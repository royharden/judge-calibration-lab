# Browser-visible configuration (public values only). Leave both empty to run the
# offline keyless demo (MemoryStore, synthetic data, page memory only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side secrets are NOT set here and must never use a VITE_ prefix.
# Configure them as Bolt / Supabase edge-function secrets for `judge-run` (names only):
#   ANTHROPIC_API_KEY
#   OPENAI_COMPATIBLE_API_KEY
#   OPENAI_COMPATIBLE_BASE_URL
#   TYPESAFE_API_KEY
