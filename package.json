{
  "name": "judge-calibration-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "LLM-judge calibration mini-lab: judge-vs-human agreement, human reference level, and a preregistered held-out verdict for one rubric edit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "sync:fn": "tsx scripts/sync-fn-shared.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
